generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id        String   @id @default(cuid())
    name      String
    email     String   @unique
    password  String
    createdAt DateTime @default(now()) @map(name: "created_at")
    updatedAt DateTime @updatedAt @map(name: "updated_at")

    task Task[]

    @@map(name: "user")
}

model Task {
    id        String   @id @default(cuid())
    taskName  String   @map(name: "task_name")
    desc      String
    deadline  DateTime
    isDelete  Boolean  @map(name: "is_delete")
    isToSend  Boolean  @map(name: "is_to_send")
    createdAt DateTime @default(now()) @map(name: "created_at")
    updatedAt DateTime @updatedAt @map(name: "updated_at")
    User      User?    @relation(fields: [userId], references: [id])
    userId    String?

    @@map(name: "task")
}
