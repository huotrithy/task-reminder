generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id        String   @id @default(cuid())
    name      String
    email     String   @unique
    password  String
    createdAt DateTime @default(now()) @map(name: "created_at")
    updatedAt DateTime @updatedAt @map(name: "updated_at")

    category Category[]

    @@map(name: "user")
}

model Category {
    id           String  @id @default(cuid())
    categoryName String  @map(name: "category_name")
    isDelete     Boolean @map(name: "is_delete")
    User         User?   @relation(fields: [userId], references: [id])
    userId       String?

    task Task[]

    @@map(name: "category")
}

model Task {
    id         String   @id @default(cuid())
    taskName   String   @map(name: "task_name")
    desc       String?
    deadline   DateTime
    isDelete   Boolean  @map(name: "is_delete")
    isToSend   Boolean  @map(name: "is_to_send")
    createdAt  DateTime @default(now()) @map(name: "created_at")
    updatedAt  DateTime @updatedAt @map(name: "updated_at")
    Category   Category @relation(fields: [categoryId], references: [id])
    categoryId String

    @@map(name: "task")
}
